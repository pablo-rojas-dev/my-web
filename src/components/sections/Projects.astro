---
import {
  ArrowUpRight,
  ChevronLeft,
  ChevronRight,
} from "@lucide/astro";

import ShowMoreButton from "../ui/ShowMoreButton.astro";
import type { ProjectsData } from "../../types";

const { data } = Astro.props as {
  data: ProjectsData;
};
---

<section class="mx-auto w-full">
  {
    data.items.map((project) => (
      <article class="mb-16 grid gap-8 md:grid-cols-2">
        <!-- Carousel -->
        <div
          class="relative overflow-hidden rounded-xl"
          data-carousel
        >
          <!-- Images -->
          <div
            class="carousel-track flex snap-x snap-mandatory overflow-x-auto scroll-smooth"
          >
            {project.images.map((image, index) => (
              <div
                class="carousel-slide w-full shrink-0 snap-start"
                data-index={index}
              >
                <img
                  src={image}
                  alt={`${project.title} - Image ${index + 1}`}
                  class="h-full w-full object-cover"
                  loading="lazy"
                />
              </div>
            ))}
          </div>

          <!-- Previous button -->
          <button
            type="button"
            class="carousel-prev absolute left-3 top-1/2 z-10 -translate-y-1/2 rounded-full bg-white/80 px-3 py-2 text-2xl font-bold shadow transition hover:bg-lime-400"
            aria-label="Previous image"
          >
            <ChevronLeft />
          </button>

          <!-- Next button -->
          <button
            type="button"
            class="carousel-next absolute right-3 top-1/2 z-10 -translate-y-1/2 rounded-full bg-white/80 px-3 py-2 text-2xl font-bold shadow transition hover:bg-lime-400"
            aria-label="Next image"
          >
            <ChevronRight />
          </button>

          <!-- Dots -->
          <div class="carousel-dots absolute bottom-4 left-1/2 z-10 flex -translate-x-1/2 gap-2">
            {project.images.map((_, index) => (
              <button
                type="button"
                data-index={index}
                class:list={[
                  "carousel-dot h-2 w-2 rounded-full transition-all duration-300",
                  index === 0
                    ? "scale-125 bg-lime-400"
                    : "bg-white/70",
                ]}
                aria-label={`Go to image ${index + 1}`}
              />
            ))}
          </div>
        </div>

        <!-- Project information -->
        <div class="flex flex-col items-center md:items-start">
          <div class="mb-5 flex w-full flex-col items-center justify-center gap-4 md:flex-row md:justify-between">
            <div class="inline-flex items-center gap-2 text-xl font-bold">
              {project.title}

              <ArrowUpRight class="arrow h-5 w-5 transition-transform duration-300" />
            </div>

            <a
              href={project.githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="stop-click group inline-flex items-center gap-2 rounded-full border border-black px-4 py-1.5 text-sm font-semibold text-black transition hover:bg-black hover:text-white"
            >
              <span class="icon github" />

              GitHub
            </a>
          </div>

          <p class="mb-6 max-w-xl text-base leading-relaxed text-neutral-700">
            {project.description}
          </p>

          <div class="flex flex-wrap justify-center gap-3 md:justify-start">
            {project.tags.map((tag) => (
              <span class="rounded-full border border-black px-4 py-1 text-sm font-medium">
                {tag}
              </span>
            ))}
          </div>
        </div>
      </article>
    ))
  }

  <ShowMoreButton />
</section>

<script>
  function initializeCarousels() {
    const carousels =
      document.querySelectorAll<HTMLElement>("[data-carousel]");

    carousels.forEach((carousel) => {
      // Avoid registering the listeners more than once.
      if (carousel.dataset.initialized === "true") {
        return;
      }

      carousel.dataset.initialized = "true";

      const track =
        carousel.querySelector<HTMLElement>(".carousel-track");

      const slides = Array.from(
        carousel.querySelectorAll<HTMLElement>(".carousel-slide"),
      );

      const dots = Array.from(
        carousel.querySelectorAll<HTMLButtonElement>(
          ".carousel-dot",
        ),
      );

      const previousButton =
        carousel.querySelector<HTMLButtonElement>(
          ".carousel-prev",
        );

      const nextButton =
        carousel.querySelector<HTMLButtonElement>(
          ".carousel-next",
        );

      if (!track || slides.length === 0) {
        return;
      }

      let currentIndex = 0;

      /*
       * Update the visual state of the navigation dots.
       */
      const updateDots = (index: number) => {
        dots.forEach((dot, dotIndex) => {
          const isActive = dotIndex === index;

          dot.classList.toggle(
            "bg-lime-400",
            isActive,
          );

          dot.classList.toggle(
            "scale-125",
            isActive,
          );

          dot.classList.toggle(
            "bg-white/70",
            !isActive,
          );
        });
      };

      /*
       * Move the carousel to a specific slide.
       */
      const goToSlide = (index: number) => {
        if (index < 0) {
          index = slides.length - 1;
        }

        if (index >= slides.length) {
          index = 0;
        }

        currentIndex = index;

        const slide = slides[currentIndex];

        track.scrollTo({
          left: slide.offsetLeft,
          behavior: "smooth",
        });

        updateDots(currentIndex);
      };

      /*
       * Previous image.
       */
      previousButton?.addEventListener(
        "click",
        (event) => {
          event.preventDefault();
          event.stopPropagation();

          goToSlide(currentIndex - 1);
        },
      );

      /*
       * Next image.
       */
      nextButton?.addEventListener(
        "click",
        (event) => {
          event.preventDefault();
          event.stopPropagation();

          goToSlide(currentIndex + 1);
        },
      );

      /*
       * Dot navigation.
       */
      dots.forEach((dot, index) => {
        dot.addEventListener("click", (event) => {
          event.preventDefault();
          event.stopPropagation();

          goToSlide(index);
        });
      });

      /*
       * Synchronize dots when the user manually scrolls
       * using:
       *
       * - Mouse
       * - Trackpad
       * - Touch
       * - Mobile swipe
       */
      let ticking = false;

      track.addEventListener(
        "scroll",
        () => {
          if (ticking) {
            return;
          }

          ticking = true;

          requestAnimationFrame(() => {
            /*
             * Find the horizontal center of the visible
             * carousel area.
             */
            const viewportCenter =
              track.scrollLeft +
              track.clientWidth / 2;

            let closestIndex = 0;
            let closestDistance = Infinity;

            /*
             * Determine which slide is closest
             * to the center.
             */
            slides.forEach((slide, index) => {
              const slideCenter =
                slide.offsetLeft +
                slide.offsetWidth / 2;

              const distance = Math.abs(
                viewportCenter - slideCenter,
              );

              if (distance < closestDistance) {
                closestDistance = distance;
                closestIndex = index;
              }
            });

            /*
             * Update the active dot only when the
             * visible slide changes.
             */
            if (closestIndex !== currentIndex) {
              currentIndex = closestIndex;

              updateDots(currentIndex);
            }

            ticking = false;
          });
        },
        {
          passive: true,
        },
      );

      /*
       * Initial state.
       */
      updateDots(currentIndex);
    });
  }

  /*
   * Standard Astro page load.
   */
  initializeCarousels();

  /*
   * Also works if Astro View Transitions
   * are enabled.
   */
  document.addEventListener(
    "astro:page-load",
    initializeCarousels,
  );
</script>